# Alpaca paper-trading + market data (https://alpaca.markets — paper keys, free IEX feed)
ALPACA_API_KEY_ID=your_paper_key_id
ALPACA_API_SECRET_KEY=your_paper_secret_key
ALPACA_DATA_FEED=iex

# Local OpenAI-compatible LLM gateway (agent + AI briefs); any vLLM/Ollama server works
SCT_LLM_BASE_URL=http://127.0.0.1:8000/v1
SCT_LLM_MODEL=auto

# Web app bind (optional; defaults 127.0.0.1:8011)
# SCT_HOST=127.0.0.1
# SCT_PORT=8011
